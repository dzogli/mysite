<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель управления — Dzogli.kz</title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; background: #f4f6f8; margin: 0; padding: 40px 20px; color: #1a1a1a; }
        .container { max-width: 650px; margin: 0 auto; background: #fff; padding: 30px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        h1 { margin-top: 0; font-size: 24px; border-bottom: 2px solid #f0f0f0; padding-bottom: 15px; }
        .group { margin-bottom: 20px; }
        label { display: block; font-weight: 600; margin-bottom: 8px; font-size: 14px; }
        input, textarea { width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 15px; box-sizing: border-box; }
        textarea { height: 90px; resize: vertical; }
        button { background: #f6d64a; border: none; padding: 14px 28px; font-weight: 700; font-size: 16px; border-radius: 8px; cursor: pointer; width: 100%; transition: background 0.2s; }
        button:hover { background: #e5c438; }
        .status { margin-top: 15px; padding: 12px; border-radius: 8px; font-weight: 600; display: none; }
        .status.success { background: #e1f3d8; color: #67c23a; display: block; }
        .status.error { background: #fde2e2; color: #f56c6c; display: block; }
    </style>
</head>
<body>

<div class="container">
    <h1>Управление контентом Dzogli.kz</h1>

    <div class="group">
        <label>Токен доступа GitHub (PAT):</label>
        <input type="password" id="ghToken" placeholder="github_pat_...">
    </div>

    <hr style="margin: 25px 0; border: none; border-top: 1px solid #eee;">

    <div class="group">
        <label>Главный заголовок сайта:</label>

        <input type="text" id="hero_title">
    </div>

    <div class="group">
        <label>Подзаголовок (текст формы):</label>
        <textarea id="hero_subtitle"></textarea>
    </div>

    <div class="group">
        <label>Телефон для связи:</label>
        <input type="text" id="phone">
    </div>

    <button onclick="saveData()">Сохранить и обновить сайт</button>
    <div id="status" class="status"></div>
</div>

<script>
    const OWNER = 'dzogli';
    const REPO = 'mysite'; // Ваше название репозитория
    const PATH = 'content.json';

    let fileSha = '';

    // Авто-загрузка токена из браузера
    document.getElementById('ghToken').value = localStorage.getItem('dzogli_gh_token') || '';

    async function loadData() {
        try {
            const res = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${PATH}`);
            const data = await res.json();
            fileSha = data.sha;
            
            const content = JSON.parse(decodeURIComponent(escape(atob(data.content))));
            document.getElementById('hero_title').value = content.hero_title || '';
            document.getElementById('hero_subtitle').value = content.hero_subtitle || '';
            document.getElementById('phone').value = content.phone || '';
        } catch (e) {
            console.error("Ошибка загрузки:", e);
        }
    }

    async function saveData() {
        const token = document.getElementById('ghToken').value.trim();
        if(!token) return showStatus('Введите GitHub токен!', 'error');

        localStorage.setItem('dzogli_gh_token', token);

        const updatedContent = {
            hero_title: document.getElementById('hero_title').value,
            hero_subtitle: document.getElementById('hero_subtitle').value,
            phone: document.getElementById('phone').value,
            company_name: "ИП \"Smmartmedia\"",
            address: "Алматы, Казахстан"
        };

        const encodedContent = btoa(unescape(encodeURIComponent(JSON.stringify(updatedContent, null, 2))));

        showStatus('Сохранение...', '');

        try {
            const res = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${PATH}`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    message: 'Update content via Admin',
                    content: encodedContent,
                    sha: fileSha
                })
            });

            if(res.ok) {
                const result = await res.json();
                fileSha = result.content.sha;
                showStatus('Успешно сохранено! Сайт обновится через несколько секунд.', 'success');
            } else {
                showStatus('Ошибка сохранения. Проверьте токен и права.', 'error');
            }
        } catch (e) {
            showStatus('Ошибка сети или токена', 'error');
        }
    }

    function showStatus(msg, type) {
        const el = document.getElementById('status');
        el.innerText = msg;
        el.className = 'status ' + type;
    }

    loadData();
</script>

</body>
</html>